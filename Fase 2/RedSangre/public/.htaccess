RewriteEngine On

# Comentarios - Cabeceras de seguridad
# Oculta el listado de carpetas (por ejemplo /assets/) y no publica los archivos .zip
Options -Indexes
<FilesMatch "\.zip$">
  Require all denied
</FilesMatch>

# Comentarios - Cabeceras de seguridad
# HSTS: el navegador solo entra por HTTPS. X-Frame-Options y frame-ancestors: nadie puede meter el sitio en un iframe.
# nosniff: el navegador no adivina tipos de archivo. Referrer-Policy: el token de /activar no viaja a otros sitios.
# CSP: solo se cargan scripts propios y de Turnstile, y solo se conecta a Supabase (API y Realtime).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Comentarios - Despliegue al hosting
  # index.html no se guarda en caché: tras cada despliegue el navegador pide la versión nueva
  # (los archivos de assets/ cambian de nombre en cada build, así que esos sí se pueden guardar)
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://igipfzkmpkkgcabopbhs.supabase.co wss://igipfzkmpkkgcabopbhs.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# SPA: toda ruta que no sea un archivo real va a index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
